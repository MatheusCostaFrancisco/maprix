# Postgres do Railway (Railway -> Postgres -> Variables -> DATABASE_URL "Public Network")
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Secret para assinar JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# URL do frontend (CORS com credentials) — em dev, http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Porta da API (Railway injeta PORT)
PORT=3000

# "production" em deploy; "development" local
NODE_ENV=development

# Conta de cartório semeada pelo seed (cartório é seed/convite, não signup público)
SEED_CARTORIO_EMAIL=cartorio@maprix.com.br
SEED_CARTORIO_PASSWORD=troque-esta-senha
SEED_CARTORIO_NAME=Cartório Demo
